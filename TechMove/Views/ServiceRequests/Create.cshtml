@model TechMove.Models.ViewModels.ServiceRequestCreateViewModel

@{
    ViewData["Title"] = "Create Service Request";
}

<div class="entity-page">
    <div class="form-card">
        <div class="record-header">
            <div>
                <h1 class="entity-title mb-2">Create Service Request</h1>
                <p class="entity-subtitle">
                    Create a new service request linked to a contract and automatically calculate the ZAR amount.
                </p>
            </div>
        </div>

        <form asp-action="Create" class="styled-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="ContractId" class="form-label styled-label">Contract</label>
                <select asp-for="ContractId" asp-items="Model.Contracts" class="form-control styled-input">
                    <option value="">-- Select Contract --</option>
                </select>
                <span asp-validation-for="ContractId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="form-label styled-label"></label>
                <input asp-for="Description" class="form-control styled-input" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CostUSD" class="form-label styled-label">Cost USD</label>
                <input asp-for="CostUSD" class="form-control styled-input" />
                <span asp-validation-for="CostUSD" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Status" class="form-label styled-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<TechMove.Models.Enums.ServiceRequestStatus>()" class="form-control styled-input"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            @if (Model.ExchangeRateUsed > 0)
            {
                <div class="exchange-info-box">
                    <p><strong>Exchange Rate Used:</strong> @Model.ExchangeRateUsed</p>
                    <p><strong>Calculated ZAR Amount:</strong> @Model.LocalCostZAR</p>
                </div>
            }

            <div class="record-actions">
                <input type="submit" value="Create Service Request" class="btn record-btn record-btn-primary" />
                <a asp-action="Index" class="btn record-btn record-btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}